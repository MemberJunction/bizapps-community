[
  {
    "fields": {
      "Name": "Ask-First Deflection",
      "Description": "Pre-submission search deflection across already-solved Q&A answers (and, when supplied, Living Documents) in the forums the member may read. Scores the best match with a deterministic keyword-overlap rubric — graceful fallback when no vector/AI search service is wired in — and declines to deflect when nothing clears MinConfidence.",
      "Type": "Custom",
      "DriverClass": "Community.AskFirstDeflection",
      "IconClass": "fa-solid fa-magnifying-glass",
      "UserPrompt": "Search for an existing answer before posting a new question.",
      "CodeApprovalStatus": "Approved",
      "Status": "Active"
    },
    "primaryKey": {
      "ID": "EE9A6630-CEF5-4996-8AB8-1CA68B2FF475"
    },
