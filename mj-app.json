{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "mj-bizapps-community",
  "displayName": "BizApps Community",
  "description": "AI-native member discussions, self-collapsing thread syntheses, personalized digests, and reply-by-email built on BizApps Collaboration spaces — where every conversation stays in your database and enriches your organization's AI context.",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "icon": "fa-solid fa-comments",
  "color": "#0D9488",
  "publisher": {
    "name": "MemberJunction",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/bizapps-community",
  "mjVersionRange": ">=6.2.0-edge.7 <7.0.0",
  "dependencies": {
    "mj-bizapps-common": {
      "version": ">=5.59.0 <6.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-common"
    },
    "mj-bizapps-tasks": {
      "version": ">=1.5.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-tasks"
    },
    "mj-bizapps-collaboration": {
      "version": ">=0.1.0 <1.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-collaboration"
    },
    "mj-bizapps-forms": {
      "version": ">=0.16.0 <1.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-forms"
    }
  },
  "schema": {
    "name": "__mj_BizAppsCommunity",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@mj-biz-apps/community-server",
        "role": "bootstrap",
        "startupExport": "LoadBizAppsCommunityServer"
      },
      {
        "name": "@mj-biz-apps/community-core-entities-server",
        "role": "library"
      }
    ],
    "client": [
      {
        "name": "@mj-biz-apps/community-ng",
        "role": "bootstrap",
        "startupExport": "LoadBizAppsCommunityClient"
      },
      {
        "name": "@mj-biz-apps/community-ng-widgets",
        "role": "library"
      }
    ],
    "shared": [
      {
        "name": "@mj-biz-apps/community-entities",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/community-actions",
        "role": "library",
        "platform": "node"
      },
      {
        "name": "@mj-biz-apps/community-core",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": ["Business", "Collaboration", "Community"],
  "tags": ["community", "forums", "discussions", "digest", "spaces", "knowledge"]
}
