  {
    "fields": {
      "Name": "Epistemic Answer Grading",
      "Description": "Grades a Q&A answer against its question (and, when supplied, the forum's existing canon answer) using a deterministic rubric — no LLM call required. Writes AIEpistemicStatus, AIConfidenceScore, and AIRationaleMarkdown; sets VerificationStatus to 'AI_Verified' only at or above 0.85 confidence.",
      "Type": "Custom",
      "DriverClass": "Community.EpistemicAnswerGrading",
      "IconClass": "fa-solid fa-check-double",
      "UserPrompt": "Grade this answer's epistemic status and confidence.",
      "CodeApprovalStatus": "Approved",
      "Status": "Active"
    },
    "primaryKey": {
      "ID": "FE5FFFC8-2CB4-4DC4-862F-E38DF19FE88D"
    },
